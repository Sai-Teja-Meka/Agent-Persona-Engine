# LLM API keys — at least one is required.
# Note: ingestion (ArchivistAgent) uses GROQ_API_KEY; chat (CharacterSoul) uses
# DEEPSEEK_API_KEY or GOOGLE_API_KEY. For the full pipeline set GROQ plus one other.
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# Neo4j (graph memory)
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4jneo4jneo4j

# ChromaDB (vector memory)
CHROMA_HOST=localhost
CHROMA_PORT=8000
